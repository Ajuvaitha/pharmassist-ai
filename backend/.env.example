DATABASE_URL="postgresql://pharmassist:pharmassist@localhost:5433/pharmassist?schema=public"
TEST_DATABASE_URL="postgresql://pharmassist:pharmassist@localhost:5433/pharmassist_test?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME"
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to send credentialed requests.
# Leave unset for a same-origin deployment. Never "*".
# CORS_ORIGIN="https://pharmassist.example.org"
# Every date in this system (indentDate, startDate, etc.) is stored and
# compared in UTC, and the 06:00 sweep cron is pinned to UTC in code. Set
# the process timezone to match so any other host-local date arithmetic
# (logs, ad-hoc scripts) can't quietly disagree with it.
TZ=UTC
